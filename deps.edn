{:deps {org.clojure/clojure {:mvn/version "1.12.7"}
        org.clojure/clojurescript {:mvn/version "1.12.145"}
        org.slf4j/slf4j-api {:mvn/version "2.0.20"}
        ch.qos.logback/logback-classic {:mvn/version "1.6.8"}
        com.bhauman/figwheel-main {:mvn/version "0.2.20"}
        com.bhauman/rebel-readline-cljs {:mvn/version "0.1.11"}
        org.clojure/core.async {:mvn/version "1.9.865"}
        hiccups/hiccups {:mvn/version "0.3.0"}}
 :paths ["src" "target" "resources"]
 :aliases {:fig {:main-opts ["-m" "figwheel.main" "-b" "dev" "--repl"]}
           :fig/simple {:main-opts ["-m" "figwheel.main" "-O" "simple" "-bo" "dev"]}
           :fig/min {:main-opts ["-m" "figwheel.main" "-O" "advanced" "-bo" "dev"]}
           :test {:extra-paths ["test"]
                  :main-opts ["-m" "cljs.main" "-t" "node" "-O" "simple"
                              "-d" "target/test-out" "-o" "target/test-out/test.js"
                              "-c" "reveal.test-runner"]}
           :outdated {:extra-deps {olical/depot {:mvn/version "2.4.1"}}
                      :main-opts ["-m" "depot.outdated.main"]}}}
